# The origin MCP clients connect to. The tunnel's ingress must point this
# hostname at http://wolt-mcp:3000.
WOLT_PUBLIC_URL=https://wolt.example.com

# Who may click "Allow" on the OAuth approve page — pick ONE guard.
#
# (a) Cloudflare Access in front of /authorize: your team domain and the
#     Access application's Audience (AUD) tag. Optionally narrow to emails.
WOLT_CF_ACCESS_TEAM=myteam.cloudflareaccess.com
WOLT_CF_ACCESS_AUD=
#WOLT_CF_ACCESS_EMAILS=me@example.com
#
# (b) A secret typed into the approve page (no Cloudflare needed):
#WOLT_OAUTH_APPROVE_SECRET=

# Optional: a fixed OAuth client for ChatGPT's "static credentials" option.
# Redirect URIs default to ChatGPT's and Claude's callbacks.
#WOLT_OAUTH_CLIENT_ID=chatgpt
#WOLT_OAUTH_CLIENT_SECRET=
#WOLT_OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect

# Optional: long-lived bearer tokens for clients that can only send a fixed
# Authorization header (openssl rand -base64 32; comma-separated).
#WOLT_API_TOKENS=

# Cloudflare Tunnel connector token (Zero Trust → Networks → Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=
